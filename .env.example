# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
NODE_ENV=development
PORT=3000
# Claves de 32+ caracteres (genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
DATA_KEY=
# Vacío = SQLite local (data/ruta_segura.db). En producción: postgres://usuario:clave@host:5432/base
DATABASE_URL=
# Horas que se conserva la placa tras terminar el viaje
PLACA_TTL_HORAS=2
# 0 desactiva las APIs externas (modo sin conexión / pruebas)
APIS_EXTERNAS=1
# Identificación obligatoria para Nominatim/Overpass (política de uso de OSM)
APP_USER_AGENT=NovaRutaSegura/1.0 (tu-correo@ejemplo.com)
# 1 siembra datos y cuentas de demostración también en producción
SEED_DEMO=0
