{
  "name": "ruta-segura",
  "version": "1.0.0",
  "description": "Nova · Ruta Segura: navegación nocturna colaborativa para mujeres en Cundinamarca",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "moderadora": "node --env-file-if-exists=.env src/db/moderadora.js",
    "test": "node --test --test-concurrency=1 test/"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
